# WeCare Backend Configuration (.env)
# ==============================================================================
# In Railway: You can attach a MySQL database plugin, and Railway will
# automatically provide DATABASE_URL, MYSQLHOST, MYSQLPORT, MYSQLUSER, MYSQLPASSWORD, MYSQLDATABASE.
# The WeCare API automatically detects all Railway database variables out-of-the-box!
# ==============================================================================

# ── Application Environment ──
APP_ENV=production
APP_URL=https://your-backend-service.up.railway.app
API_BASE_URL=https://your-backend-service.up.railway.app/api/v1
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=false

# ── Authentication Security ──
# Minimum 32-character secret key for JWT token hashing
JWT_SECRET=replace_with_a_secure_random_32_char_secret_key_here

# ── Rate Limiting (true in production, false for local dev) ──
RATE_LIMIT_ENABLED=true

# ── Database (Railway Auto-Configures this with MySQL Plugin) ──
# If using Railway MySQL, you can leave these or use Railway's DATABASE_URL:
# DATABASE_URL=mysql://root:password@roundhouse.proxy.rlwy.net:3306/railway
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=wecare_db
DB_USER=root
DB_PASS=
DB_CHARSET=utf8mb4

# ── CORS Settings ──
# Comma-separated list of allowed origins (e.g., your frontend URL)
# Note: *.railway.app and *.up.railway.app are automatically permitted.
CORS_ALLOWED_ORIGINS=https://your-frontend-service.up.railway.app,http://localhost:5173

# ── File Uploads ──
UPLOAD_BASE_PATH=uploads
UPLOAD_MAX_MB=5

# ── Email / SMTP (Optional for Live OTP Delivery) ──
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_16_character_app_password
SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=WeCare
